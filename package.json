{
  "name": "sistema-gestion-reparacion-tecnologica",
  "version": "1.0.0",
  "description": "Sistema de gestion integral para una empresa de reparacion de celulares y equipos tecnologicos. Analisis orientado a objetos (Guia Practica N.02 - IESTP Pajan).",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:reset": "node src/db/migrate.js --reset",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/migrate.js --reset && node src/db/seed.js",
    "test": "node --test test/",
    "publicar": "node scripts/publicar.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mysql2": "^3.11.5"
  },
  "keywords": [
    "poo",
    "taller-reparacion",
    "express",
    "mysql"
  ],
  "license": "MIT"
}
