# Copiar a .env y ajustar segun el entorno.

PORT=3000
NODE_ENV=development

# Base de datos (MySQL 8.0 o superior)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taller_reparacion
DB_CONNECTION_LIMIT=10

# Parametro controlado por el negocio, usado por el trigger de la RN-07.
MAX_ORDENES_ACTIVAS_POR_TECNICO=5
